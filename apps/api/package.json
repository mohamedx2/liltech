{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/apps/api/prisma/schema.prisma"
        ],
        "outputs": [
          "{workspaceRoot}/node_modules/.prisma/client"
        ],
        "options": {
          "command": "pnpm --filter api exec prisma generate --schema=prisma/schema.prisma"
        }
      },
      "db-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --filter api exec prisma migrate dev --schema=prisma/schema.prisma",
          "envFile": ".env"
        }
      },
      "db-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --filter api exec prisma migrate deploy --schema=prisma/schema.prisma",
          "envFile": ".env"
        }
      },
      "db-seed": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate"
        ],
        "options": {
          "command": "pnpm --filter api exec tsx prisma/seed.ts",
          "envFile": ".env"
        }
      },
      "db-provision-ctf": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate"
        ],
        "options": {
          "command": "pnpm --filter api exec tsx prisma/provision-ctf.ts",
          "envFile": ".env"
        }
      },
      "db-reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --filter api exec prisma migrate reset --schema=prisma/schema.prisma --force",
          "envFile": ".env"
        }
      },
      "db-studio": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm --filter api exec prisma studio --schema=prisma/schema.prisma",
          "envFile": ".env"
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "readyWhen": {
          "signal": true
        },
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      }
    },
    "tags": [
      "scope:api",
      "type:app"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "api-contracts": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "shared": "workspace:^",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}
