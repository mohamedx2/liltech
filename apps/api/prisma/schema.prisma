// LilTech 2026 Platform — Prisma schema
//
// The domain covers authentication accounts and sessions, team/participant
// registration (with an administrative team standing), QR badge tokens,
// check-in, the event phase state (single writer), the two sequential
// challenges with Mini-CTF early access, live announcements, and the audit log.
//
// The Mini-CTF gate (stage 1, "Louage 404") is modelled below: a stage holds
// only a SHA-256 hash of its answer, teams keep per-stage progress and a
// timestamped attempt log, and a correct answer unlocks the main challenge.
//
// Still intentionally absent (blocked on `docs/decisions/OPEN_QUESTIONS.md`):
// Mini-CTF flag material and attempt log, submissions, jury scoping, scores,
// leaderboards, results. Answers are never stored in plaintext anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Generic key/value store for platform-level metadata.
model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Roles from the LilTech specification. Enforcement happens in the API.
enum Role {
  team
  jury
  admin

  @@map("role")
}

/// Account for one of the API roles. Created by registration (team) or
/// administratively (jury/admin — provisioning endpoint pending decision).
model User {
  id                String          @id @default(uuid()) @db.Uuid
  role              Role
  email             String          @unique @db.VarChar(254)
  name              String          @db.VarChar(100)
  /// bcrypt hash (slow, salted). Never logged, never returned.
  passwordHash      String
  /// Jury accounts only: the password kept readable for administrators, who
  /// hand it to the jury member (organizer decision, AGENTS.md §9). Returned
  /// exclusively by admin-only endpoints; never logged. Null for other roles.
  juryPlainPassword String?         @db.VarChar(256)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  team              Team?
  checkInRecords    CheckInRecord[]
  auditLogs         AuditLog[]
  announcements     Announcement[]

  @@map("users")
}

/// Server-side session. Only a SHA-256 digest of the bearer token is stored;
/// the raw token is a credential shown once at login.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set when the session is logged out; expired sessions are never accepted.
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

/// Team registered by its leader. 4–7 members (leader included).
model Team {
  id              String              @id @default(uuid()) @db.Uuid
  name            String              @unique @db.VarChar(60)
  leader          User                @relation(fields: [leaderId], references: [id])
  leaderId        String              @unique @db.Uuid
  progressState   TeamProgress        @default(registered)
  /// Administrative standing; a team that is not `active` cannot be checked
  /// in and cannot read challenges.
  status          TeamStatus          @default(active)
  /// Why the team was withdrawn or disqualified (shown to administrators).
  statusReason    String?             @db.VarChar(300)
  statusChangedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  participants    Participant[]
  /// LOUAGE 404 chain: per-stage state and the timestamped attempt log.
  ctfProgress     CtfProgress[]
  ctfAttempts     CtfAttempt[]
  /// Per-challenge Mini-CTF solves (early access to a running challenge).
  ctfSolves       ChallengeCtfSolve[]

  @@index([progressState])
  @@index([status])
  @@map("teams")
}

/// Administrative standing of a team, set by administrators (audited).
enum TeamStatus {
  active
  withdrawn
  disqualified

  @@map("team_status")
}

/// Team progress through the event (canonical states from the specification).
enum TeamProgress {
  registered
  checked_in
  ctf_unlocked
  ctf_solved
  challenge_unlocked
  submitted

  @@map("team_progress")
}

/// Member of a team, including the leader. Each participant gets one QR badge.
model Participant {
  id        String         @id @default(uuid()) @db.Uuid
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String         @db.Uuid
  name      String         @db.VarChar(100)
  isLeader  Boolean
  /// Contact email; the QR badge is delivered here. Required for new
  /// registrations (nullable for teams registered before it was required).
  /// Unique across all teams — enforced in the registration transaction.
  email     String?        @db.VarChar(254)
  /// Badge color, balanced across all participants at registration time.
  color     BadgeColor?
  createdAt DateTime       @default(now())
  badge     QrToken?
  checkIn   CheckInRecord?

  @@index([teamId])
  @@index([email])
  @@index([color])
  @@map("participants")
}

/// The four badge colors participants are spread across.
enum BadgeColor {
  blue
  red
  yellow
  green

  @@map("badge_color")
}

/// Delivery state of a participant's badge email.
enum BadgeEmailStatus {
  pending
  sent
  failed

  @@map("badge_email_status")
}

/// One QR badge per participant. The raw token is high-entropy
/// (32 bytes, base64url) and only its SHA-256 digest is persisted; the badge
/// is revocable (credential semantics).
model QrToken {
  id              String            @id @default(uuid()) @db.Uuid
  participant     Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId   String            @unique @db.Uuid
  tokenHash       String            @unique @db.VarChar(64)
  /// AES-256-GCM encryption of the raw token under `QR_TOKEN_KEY`, so the
  /// owning team can display its badges again. Null for badges issued before
  /// this column existed. Never logged, never returned to anyone but the team.
  tokenCiphertext String?           @db.VarChar(255)
  issuedAt        DateTime          @default(now())
  revokedAt       DateTime?
  /// Last badge email attempt (successful or not) — drives the resend limit.
  emailLastSentAt DateTime?
  emailStatus     BadgeEmailStatus?

  @@map("qr_tokens")
}

/// Record of a successful QR check-in. One per participant — enforced by the
/// unique participant reference and checked atomically at scan time.
model CheckInRecord {
  id              String      @id @default(uuid()) @db.Uuid
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId   String      @unique @db.Uuid
  checkedInAt     DateTime    @default(now())
  checkedByUser   User        @relation(fields: [checkedByUserId], references: [id])
  checkedByUserId String      @db.Uuid

  @@index([checkedInAt])
  @@map("check_in_records")
}

/// Single-row table (id = 1). The API is the only writer.
model EventPhaseState {
  id              Int        @id @default(1)
  phase           EventPhase @default(registration)
  phaseChangedAt  DateTime   @default(now())
  changedByUserId String?    @db.Uuid

  @@map("event_phase_state")
}

enum EventPhase {
  registration
  checkin
  live
  submissions_closed
  pitching
  results

  @@map("event_phase")
}

/// Audit trail for sensitive administrative actions.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  /// Identifier of the audited target; semantics depend on `targetType`
  /// (e.g. the fixed `1` of the event phase state row).
  targetId   String?  @db.VarChar(50)
  /// Short human-readable context, e.g. `registration -> checkin`. Never
  /// holds secrets or personal data.
  summary    String?  @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

/// Lifecycle of one main challenge, driven by administrators while the
/// event phase is `live`.
enum ChallengeStatus {
  upcoming
  live
  ended

  @@map("challenge_status")
}

/// One main challenge. Challenges run one after the other (`position`). When
/// a challenge starts, teams that solved its Mini-CTF can read it at once;
/// everyone else from `publicAt` (start + `publicDelayMinutes`).
model Challenge {
  id                 String              @id @default(uuid()) @db.Uuid
  position           Int                 @unique
  title              String              @db.VarChar(150)
  /// Teaser shown to every team before the description unlocks.
  summary            String              @default("") @db.VarChar(500)
  description        String
  problemStatement   String              @default("")
  deliverables       String[]            @default([])
  /// `[{ name, url }]`, validated by the API contract.
  resources          Json                @default("[]")
  publicDelayMinutes Int                 @default(60)
  status             ChallengeStatus     @default(upcoming)
  startedAt          DateTime?
  endedAt            DateTime?
  publicAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ctfSolves          ChallengeCtfSolve[]

  @@index([status])
  @@map("challenges")
}

/// A team solved the Mini-CTF of a challenge, which gives it early access to
/// that challenge's description. Written by the Mini-CTF module through
/// `recordMiniCtfSolve`; one row per team and challenge.
model ChallengeCtfSolve {
  id          String    @id @default(uuid()) @db.Uuid
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String    @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String    @db.Uuid
  solvedAt    DateTime  @default(now())

  @@unique([challengeId, teamId])
  @@index([teamId])
  @@map("challenge_ctf_solves")
}

/// Live announcement feed.
model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String   @db.Uuid
  body        String   @db.VarChar(500)
  publishedAt DateTime @default(now())

  @@index([publishedAt])
  @@map("announcements")
}

/// Publication state of a Mini-CTF stage. Only `live` stages accept answers.
enum CtfStageStatus {
  draft
  live
  closed

  @@map("ctf_stage_status")
}

/// One Mini-CTF stage. `answerHash` is the SHA-256 (hex) of the normalized
/// answer — the plaintext answer never enters the database, the API, or the repo.
model CtfStage {
  id                String         @id @default(uuid()) @db.Uuid
  slug              String         @unique @db.VarChar(60)
  position          Int            @unique
  title             String         @db.VarChar(140)
  description       String?        @db.Text
  status            CtfStageStatus @default(draft)
  /// HMAC-SHA256 hex digest of the normalized answer, keyed by the server-only
  /// `CTF_ANSWER_PEPPER`. NULL until an organizer provisions the stage; a live
  /// stage can never be NULL (enforced by a CHECK constraint in the migration).
  answerHash        String?        @db.VarChar(64)
  /// Google Drive folder holding this stage's downloadable resources.
  /// Validated against an allowlist of Google hosts before it is stored.
  assetDriveUrl     String?        @db.VarChar(300)
  /// Whether solving this stage is required before the main challenge unlocks.
  requiredForUnlock Boolean        @default(true)
  /// Deprecated: former in-app asset paths. Assets are now hosted externally.
  assetImageUrl     String?        @db.VarChar(300)
  assetZipUrl       String?        @db.VarChar(300)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  hints             CtfHint[]
  progress          CtfProgress[]
  attempts          CtfAttempt[]

  @@map("ctf_stages")
}

/// Progressive hint for a stage. Teams unlock them one at a time, on demand.
model CtfHint {
  id       String   @id @default(uuid()) @db.Uuid
  stage    CtfStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId  String   @db.Uuid
  position Int
  body     String   @db.VarChar(300)

  @@unique([stageId, position])
  @@map("ctf_hints")
}

/// Per-team progress on one stage. Unique per team+stage so a solve is
/// recorded exactly once, no matter how many submissions arrive.
model CtfProgress {
  id        String        @id @default(uuid()) @db.Uuid
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String        @db.Uuid
  stage     CtfStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId   String        @db.Uuid
  /// Sequential chain state. A row exists only once a stage is unlocked or
  /// solved, so `locked` is also represented by the absence of a row.
  state     CtfStageState @default(locked)
  attempts  Int           @default(0)
  hintsUsed Int           @default(0)
  solvedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([teamId, stageId])
  @@index([stageId, solvedAt])
  @@index([teamId, state])
  @@map("ctf_progress")
}

/// Per-team, per-stage sequential state.
enum CtfStageState {
  locked
  unlocked
  solved

  @@map("ctf_stage_state")
}

/// Append-only attempt log (used for rate limiting evidence and review).
/// The submitted answer is never stored.
model CtfAttempt {
  id        String     @id @default(uuid()) @db.Uuid
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String     @db.Uuid
  stage     CtfStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId   String     @db.Uuid
  outcome   CtfOutcome
  createdAt DateTime   @default(now())

  @@index([teamId, createdAt])
  @@map("ctf_attempts")
}

enum CtfOutcome {
  correct
  incorrect
  rate_limited

  @@map("ctf_outcome")
}
