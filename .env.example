# LilTech 2026 Platform — environment configuration example
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real .env files. Values below are local-development examples only.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) — server-only ────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://liltech:local_dev_password@127.0.0.1:5432/liltech?schema=public

API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

# Lifetime of authentication session tokens, in hours.
SESSION_TTL_HOURS=24

# Reverse-proxy hops whose X-Forwarded-For is trusted (1 behind Caddy in
# production, 0 locally). Per-IP rate limits depend on it.
TRUST_PROXY_HOPS=0

# Swagger UI at /api/docs: on by default outside production, off in
# production unless set to true.
# API_DOCS_ENABLED=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Mini-CTF (LOUAGE 404) — server-only ─────────────────────────────────────
# Server-side pepper for HMAC-SHA256 answer digests (minimum 32 characters).
# Required at API startup. Generate one with `openssl rand -base64 48`
# and NEVER commit the real value: answers are brute-forceable without it.
CTF_ANSWER_PEPPER=replace-with-a-long-random-development-only-pepper
# Wrong-flag submissions accepted per team per minute, per stage (default 5).
CTF_SUBMIT_RATE_LIMIT_PER_MINUTE=5

# Optional path (relative to apps/api) to the organizer provisioning file that
# carries plaintext answers + Google Drive folder URLs. Keep it out of Git:
# defaults to apps/api/prisma/ctf-answers.json when unset.
CTF_PROVISION_FILE=../../ctf-assests/ctf-answers.json

# 32 random bytes (base64) encrypting stored QR badge tokens so a team can see
# its badges again. Required. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing badges unreadable (a resend then reissues them).
QR_TOKEN_KEY=

# QR badge emails (Gmail SMTP). Use a Gmail app password, never the account
# password. Leave SMTP_USER/SMTP_PASS empty to disable sending (badges are then
# only shown on the team portal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown on badge emails; defaults to SMTP_USER.
MAIL_FROM=
# Site linked from badge emails.
PUBLIC_APP_URL=http://localhost:3000

# ── Web (apps/web) — public, browser-exposed (NEXT_PUBLIC_ prefix) ──────────
# Base URL of the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# real | mock — `mock` lets the UI run without a backend.
NEXT_PUBLIC_API_MODE=real

# ── Production (VPS) ────────────────────────────────────────────────────────
# On the VPS, /opt/liltech/.env is generated by the GitHub Actions deploy job
# from repository secrets — never write it by hand. See README.md → Deployment
# and docker-compose.prod.yml. Locally, this block is intentionally inert.

# ── Seed: optional administrator provisioning (seed script, both modes) ─────
# Set both email and password (or neither — the seed then skips admin
# provisioning). Password must be at least 12 characters. Re-running the seed
# with a changed password resets the administrator's password hash.
# SEED_ADMIN_EMAIL=admin@liltechsousse.com
# SEED_ADMIN_PASSWORD=change-me-at-least-12-chars
# SEED_ADMIN_NAME=LilTech Admin
