# LilTech 2026 Platform — environment configuration example
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real .env files. Values below are local-development examples only.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) — server-only ────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://liltech:local_dev_password@127.0.0.1:5432/liltech?schema=public

API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

# Lifetime of authentication session tokens, in hours.
SESSION_TTL_HOURS=24

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Mini-CTF (LOUAGE 404) — server-only ─────────────────────────────────────
# Server-side pepper for HMAC-SHA256 answer digests. Required before any answer
# can be provisioned or verified. Generate one with `openssl rand -base64 48`
# and NEVER commit the real value: answers are brute-forceable without it.
CTF_ANSWER_PEPPER=replace-with-a-long-random-development-only-pepper

# Optional path (relative to apps/api) to the organizer provisioning file that
# carries plaintext answers + Google Drive folder URLs. Keep it out of Git:
# defaults to apps/api/prisma/ctf-answers.json when unset.
CTF_PROVISION_FILE=../../ctf-assests/ctf-answers.json

# ── Web (apps/web) — public, browser-exposed (NEXT_PUBLIC_ prefix) ──────────
# Base URL of the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# real | mock — `mock` lets the UI run without a backend.
NEXT_PUBLIC_API_MODE=real
